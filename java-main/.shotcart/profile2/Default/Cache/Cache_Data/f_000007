    )
)

/** 今日任务列表：附带进度 / 是否完成 */
export const todayTasks = computed(() =>
  DAILY_TASKS.map((t) => {
    const count = Math.min(pointsState.tasks[t.key] || 0, t.target)
    return {
      ...t,
      count,
      done: count >= t.target,
      earned: count * t.points,
    }
  })
)

/** 已完成任务数 */
export const todayDoneCount = computed(() => todayTasks.value.filter((t) => t.done).length)

